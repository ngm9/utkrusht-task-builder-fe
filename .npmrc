# Route ONLY the @ngm9 scope to GitHub Packages; everything else stays on public npm.
# The token is read from NODE_AUTH_TOKEN at install time — never hard-code it here.
#   CI:     NODE_AUTH_TOKEN = the workflow's GITHUB_TOKEN (same account can read the package)
#   local:  a personal access token with `read:packages`
#   Docker: pass it as a build secret, not an ARG (an ARG lands in the image history)
# Copied verbatim from recruiter-utkrusht so both consumers resolve the client
# the same way.
@ngm9:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
